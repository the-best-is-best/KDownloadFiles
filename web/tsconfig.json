{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "kdownloadfile": [
        "../kDownloadFile/build/dist/js/productionLibrary/kdownloadfile.d.mts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "testFiles.ts"
  ]
}
